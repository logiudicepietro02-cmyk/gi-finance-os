// GI FINANCE OS — data model
// Conventions: every domain entity has id/createdAt/updatedAt and organizationId (tenant).
// Monetary values: Decimal(18,2) in EUR. Rates: percent Decimal(7,4).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  OWNER
  ADVISOR
  ANALYST
}

enum CompanyStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  CLOSED
}

enum DocumentType {
  BILANCIO
  VISURA
  DOCUMENTO_BANCARIO
  FINANZIAMENTO
  BUSINESS_PLAN
  SITUAZIONE_CONTABILE
  DOCUMENTO_IDENTITA
  ALTRO
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum ClassificationSource {
  USER
  RULES
  AI
}

enum ExtractionMethod {
  AI
  RULES
  MANUAL
  SEED
}

enum ExtractionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum StatementType {
  ANNUAL
  INTERIM
}

enum StatementStatus {
  EXTRACTED
  VERIFIED
}

enum MetricStatus {
  OK
  MISSING
  NOT_MEANINGFUL
}

enum OperationSource {
  CLIENTE_PROPRIO
  STUDIO_MARTINELLI
  STUDIO_GI
  ALTRO
}

enum OperationType {
  MUTUO_CHIROGRAFARIO
  MUTUO_IPOTECARIO
  FINANZIAMENTO_GARANTITO
  FIDO_CASSA
  ANTICIPO_FATTURE
  LEASING
  FACTORING
  MINIBOND
  ALTRO
}

enum OperationStatus {
  LEAD
  ANALYSIS
  DOCUMENTATION
  SUBMITTED
  NEGOTIATION
  APPROVED
  COMPLETED
  REJECTED
}

enum RateType {
  FIXED
  VARIABLE
}

enum FeeType {
  FIXED
  PERCENTAGE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ChecklistStatus {
  MISSING
  REQUESTED
  RECEIVED
  VERIFIED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskSource {
  MANUAL
  AI
  BRIEFING
  ALERT
  CHECKLIST
}

enum AlertType {
  DSCR_BELOW_THRESHOLD
  NET_DEBT_EBITDA_ABOVE_THRESHOLD
  FINANCING_MATURITY
  MISSING_REQUIRED_DOCUMENT
  TASK_OVERDUE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum InsightKind {
  VARIATION
  FINANCIAL_INTERPRETATION
  CLIENT_BRIEFING
  NEXT_BEST_ACTION
  OPERATION_SUMMARY
  DAILY_BRIEFING
  DOCUMENT_INSIGHT
}

enum InsightSource {
  RULES
  AI
}

enum InsightStatus {
  ACTIVE
  DISMISSED
}

enum AIRunKind {
  DOCUMENT_CLASSIFICATION
  DOCUMENT_EXTRACTION
  DOCUMENT_INSIGHT
  COPILOT
  FINANCIAL_INTERPRETATION
  CLIENT_BRIEFING
  NEXT_BEST_ACTION
  OPERATION_SUMMARY
  DAILY_BRIEFING
}

enum AIRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum ApprovalType {
  CREATE_TASK
  UPDATE_FINANCIAL_STATEMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ───────────────────────────── Tenancy & identity ─────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  /// Thresholds & preferences, validated by lib/settings (zod)
  settings    Json      @default("{}")
  alertsRunAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users              User[]
  companies          Company[]
  contacts           CompanyContact[]
  documents          Document[]
  documentChunks     DocumentChunk[]
  extractions        DocumentExtraction[]
  statements         FinancialStatement[]
  metrics            FinancialMetric[]
  operations         FinancingOperation[]
  financingDocuments FinancingDocument[]
  tasks              Task[]
  insights           Insight[]
  alerts             Alert[]
  conversations      AIConversation[]
  messages           AIMessage[]
  aiRuns             AIRun[]
  auditLogs          AuditLog[]
  approvals          ApprovalRequest[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(ANALYST)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions          Session[]
  assignedCompanies Company[]            @relation("CompanyAdvisor")
  uploadedDocuments Document[]           @relation("DocumentUploader")
  assignedTasks     Task[]               @relation("TaskAssignee")
  createdTasks      Task[]               @relation("TaskCreator")
  ownedOperations   FinancingOperation[] @relation("OperationOwner")
  conversations     AIConversation[]
  auditLogs         AuditLog[]

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the session token; the raw token only lives in the cookie
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Companies ─────────────────────────────

model Company {
  id                String        @id @default(cuid())
  organizationId    String
  name              String
  legalForm         String?
  taxCode           String?
  vatNumber         String?
  reaNumber         String?
  atecoCode         String?
  sector            String?
  address           String?
  city              String?
  province          String?
  postalCode        String?
  country           String        @default("IT")
  website           String?
  employees         Int?
  /// Indicative revenue declared at onboarding; statements take precedence
  declaredRevenue   Decimal?      @db.Decimal(18, 2)
  foundedYear       Int?
  status            CompanyStatus @default(ACTIVE)
  assignedAdvisorId String?
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAdvisor User?                @relation("CompanyAdvisor", fields: [assignedAdvisorId], references: [id], onDelete: SetNull)
  contacts        CompanyContact[]
  documents       Document[]
  documentChunks  DocumentChunk[]
  extractions     DocumentExtraction[]
  statements      FinancialStatement[]
  metrics         FinancialMetric[]
  operations      FinancingOperation[]
  tasks           Task[]
  insights        Insight[]
  alerts          Alert[]
  conversations   AIConversation[]
  approvals       ApprovalRequest[]

  @@unique([organizationId, vatNumber])
  @@index([organizationId, name])
}

model CompanyContact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId, companyId])
}

// ───────────────────────────── Documents ─────────────────────────────

model Document {
  id                       String                @id @default(cuid())
  organizationId           String
  companyId                String?
  uploadedById             String?
  fileName                 String
  mimeType                 String
  sizeBytes                Int
  storageKey               String                @unique
  checksum                 String
  type                     DocumentType          @default(ALTRO)
  typeSource               ClassificationSource?
  classificationConfidence Float?
  fiscalYear               Int?
  status                   DocumentStatus        @default(UPLOADED)
  pageCount                Int?
  extractedText            String?
  /// [{ step, status, startedAt, finishedAt, message }]
  processingLog            Json?
  processedAt              DateTime?
  errorMessage             String?
  description              String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company            Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy         User?                @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks             DocumentChunk[]
  extractions        DocumentExtraction[]
  statements         FinancialStatement[]
  financingDocuments FinancingDocument[]

  @@index([organizationId, companyId])
  @@index([organizationId, status])
}

model DocumentChunk {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  documentId     String
  pageNumber     Int
  chunkIndex     Int
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, companyId])
  @@index([documentId])
}

model DocumentExtraction {
  id                   String           @id @default(cuid())
  organizationId       String
  documentId           String
  companyId            String?
  documentType         DocumentType
  method               ExtractionMethod
  status               ExtractionStatus @default(PENDING_REVIEW)
  schemaVersion        String
  fiscalYear           Int?
  /// Normalized fields: { fields: { revenue: { value, page, sourceText } ... }, meta }
  data                 Json
  /// { valid, errors: [], warnings: [] }
  validation           Json?
  confidence           Float?
  aiRunId              String?
  financialStatementId String?
  /// CREATED_STATEMENT | UPDATED_UNVERIFIED | PROPOSED_UPDATE | NONE
  appliedAction        String?
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNotes          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document           Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialStatement FinancialStatement? @relation(fields: [financialStatementId], references: [id], onDelete: SetNull)
  approvals          ApprovalRequest[]

  @@index([organizationId, status])
  @@index([documentId])
}

// ───────────────────────────── Financials ─────────────────────────────

model FinancialStatement {
  id                   String          @id @default(cuid())
  organizationId       String
  companyId            String
  fiscalYear           Int
  periodEnd            DateTime?
  type                 StatementType   @default(ANNUAL)
  currency             String          @default("EUR")
  status               StatementStatus @default(EXTRACTED)
  sourceDocumentId     String?
  revenue              Decimal?        @db.Decimal(18, 2)
  ebitda               Decimal?        @db.Decimal(18, 2)
  ebit                 Decimal?        @db.Decimal(18, 2)
  netIncome            Decimal?        @db.Decimal(18, 2)
  cash                 Decimal?        @db.Decimal(18, 2)
  financialDebt        Decimal?        @db.Decimal(18, 2)
  netFinancialPosition Decimal?        @db.Decimal(18, 2)
  equity               Decimal?        @db.Decimal(18, 2)
  currentAssets        Decimal?        @db.Decimal(18, 2)
  currentLiabilities   Decimal?        @db.Decimal(18, 2)
  inventory            Decimal?        @db.Decimal(18, 2)
  totalAssets          Decimal?        @db.Decimal(18, 2)
  interestExpense      Decimal?        @db.Decimal(18, 2)
  principalRepayment   Decimal?        @db.Decimal(18, 2)
  depreciation         Decimal?        @db.Decimal(18, 2)
  /// { fieldName: { documentId, extractionId, page, sourceText, method } }
  fieldSources         Json?
  verifiedById         String?
  verifiedAt           DateTime?
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceDocument Document?            @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  metrics        FinancialMetric[]
  extractions    DocumentExtraction[]

  @@unique([companyId, fiscalYear, type])
  @@index([organizationId])
}

model FinancialMetric {
  id                   String       @id @default(cuid())
  organizationId       String
  companyId            String
  financialStatementId String
  fiscalYear           Int
  key                  String
  value                Decimal?     @db.Decimal(24, 6)
  status               MetricStatus
  formula              String
  /// [{ field, label, value }]
  inputs               Json
  computedAt           DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statement    FinancialStatement @relation(fields: [financialStatementId], references: [id], onDelete: Cascade)

  @@unique([financialStatementId, key])
  @@index([organizationId, companyId, key])
}

// ───────────────────────────── Financing ─────────────────────────────

model FinancingOperation {
  id              String          @id @default(cuid())
  organizationId  String
  companyId       String
  title           String
  bank            String
  type            OperationType
  /// Provenienza della pratica: cliente proprio del consulente, studio partner, o altro
  source          OperationSource @default(CLIENTE_PROPRIO)
  /// Nome dello studio/segnalatore quando source = ALTRO
  sourceDetail    String?
  amount          Decimal?        @db.Decimal(18, 2)
  outstandingDebt Decimal?        @db.Decimal(18, 2)
  /// Annual nominal rate in percent (e.g. 4.25)
  rate            Decimal?        @db.Decimal(7, 4)
  rateType        RateType?
  /// Fee di mediazione dello studio: importo fisso (€) o percentuale su `amount`, a seconda di feeType
  feeType               FeeType?
  feeValue              Decimal?      @db.Decimal(18, 4)
  feeDiscountType       DiscountType?
  feeDiscountValue      Decimal?      @db.Decimal(18, 4)
  /// Retainer di consulenza ricorrente fatturato al cliente, indipendente dallo stato della pratica
  monthlyRetainer       Decimal?      @db.Decimal(18, 2)
  retainerActive        Boolean       @default(false)
  retainerStartDate     DateTime?
  retainerEndDate       DateTime?
  retainerDiscountType  DiscountType?
  retainerDiscountValue Decimal?      @db.Decimal(18, 4)
  durationMonths  Int?
  startDate       DateTime?
  maturityDate    DateTime?
  status          OperationStatus @default(LEAD)
  /// 0-100
  probability     Int?
  guarantee       String?
  notes           String?
  ownerId         String?
  createdById     String?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner        User?               @relation("OperationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  checklist    FinancingDocument[]
  tasks        Task[]
  insights     Insight[]

  @@index([organizationId, status])
  @@index([organizationId, companyId])
}

/// Required-document checklist item of a financing operation
model FinancingDocument {
  id             String          @id @default(cuid())
  organizationId String
  operationId    String
  name           String
  documentType   DocumentType
  required       Boolean         @default(true)
  status         ChecklistStatus @default(MISSING)
  documentId     String?
  dueDate        DateTime?
  notes          String?
  requestedAt    DateTime?
  receivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operation    FinancingOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  document     Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([operationId])
}

// ───────────────────────────── Work ─────────────────────────────

model Task {
  id                  String       @id @default(cuid())
  organizationId      String
  title               String
  description         String?
  companyId           String?
  operationId         String?
  financingDocumentId String?
  assigneeId          String?
  priority            TaskPriority @default(MEDIUM)
  status              TaskStatus   @default(TODO)
  dueDate             DateTime?
  createdById         String?
  source              TaskSource   @default(MANUAL)
  aiRunId             String?
  alertId             String?
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operation         FinancingOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  financingDocument FinancingDocument?  @relation(fields: [financingDocumentId], references: [id], onDelete: SetNull)
  assignee          User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([organizationId, assigneeId])
  @@index([organizationId, companyId])
}

model Alert {
  id               String        @id @default(cuid())
  organizationId   String
  companyId        String?
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  title            String
  message          String
  /// Entity that triggered the rule (FinancialStatement, FinancingOperation, FinancingDocument, Task)
  sourceType       String
  sourceId         String
  /// Stable key of the rule instance: one row per (rule, source)
  dedupeKey        String
  data             Json?
  firstDetectedAt  DateTime      @default(now())
  lastDetectedAt   DateTime      @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  insights     Insight[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
}

model Insight {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String?
  operationId    String?
  alertId        String?
  kind           InsightKind
  source         InsightSource
  status         InsightStatus  @default(ACTIVE)
  severity       AlertSeverity?
  title          String
  summary        String?
  content        Json?
  /// [{ id, type, label, entityId }]
  sourceRefs     Json?
  aiRunId        String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operation    FinancingOperation? @relation(fields: [operationId], references: [id], onDelete: Cascade)
  alert        Alert?              @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([organizationId, companyId, kind])
  @@index([organizationId, kind, createdAt])
}

// ───────────────────────────── AI ─────────────────────────────

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  companyId      String?
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages     AIMessage[]

  @@index([organizationId, userId, updatedAt])
}

model AIMessage {
  id             String      @id @default(cuid())
  organizationId String
  conversationId String
  role           MessageRole
  content        String
  /// [{ name, input, ok, summary }]
  toolCalls      Json?
  sources        Json?
  aiRunId        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIRun {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  companyId      String?
  kind           AIRunKind
  provider       String
  model          String
  status         AIRunStatus @default(RUNNING)
  input          Json?
  output         Json?
  error          String?
  inputTokens    Int?
  outputTokens   Int?
  durationMs     Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

model ApprovalRequest {
  id                   String         @id @default(cuid())
  organizationId       String
  companyId            String?
  type                 ApprovalType
  status               ApprovalStatus @default(PENDING)
  title                String
  payload              Json
  reason               String?
  requestedByUserId    String?
  aiRunId              String?
  documentExtractionId String?
  decidedById          String?
  decidedAt            DateTime?
  resultEntityId       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  extraction   DocumentExtraction? @relation(fields: [documentExtractionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  actorType      ActorType
  action         String
  entityType     String
  entityId       String?
  companyId      String?
  aiRunId        String?
  toolName       String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, companyId, createdAt])
  @@index([organizationId, entityType, entityId])
}
