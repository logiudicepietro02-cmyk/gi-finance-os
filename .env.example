# ─── Database ──────────────────────────────────────────────
# Any PostgreSQL works (local, Docker, Supabase, Neon).
# `npm run db:start` launches an embedded Postgres matching this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/gi_finance_os"
# Isolated databases for automated tests (created by `npm run db:start`)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/gi_finance_os_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/gi_finance_os_e2e"
# Embedded Postgres data directory. Keep it OUTSIDE synced folders (OneDrive/Dropbox).
# Default: <home>/.gi-finance-os/postgres
PG_DATA_DIR=

# ─── App ───────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── Storage ───────────────────────────────────────────────
# local | s3  (s3 = any S3-compatible storage, incl. Supabase Storage S3 endpoint)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_MB="25"
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE="true"

# ─── AI ────────────────────────────────────────────────────
# anthropic | openai | none
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-opus-5"
# Server-side refusal fallback on Claude (default | off)
ANTHROPIC_FALLBACKS="default"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5"
