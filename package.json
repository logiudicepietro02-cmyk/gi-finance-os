{
  "name": "gi-finance-os",
  "version": "0.1.0",
  "private": true,
  "description": "GI FINANCE OS — Il copilota operativo del consulente finanziario",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:start": "node scripts/db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "e2e:server": "node scripts/e2e-server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.2.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^7.15.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
